{
  "version": 1,
  "targets": [
    {
      "repository": "OWNER/PROJECT",
      "enabled": false,
      "agent_rules": {
        "enabled": false,
        "source": "templates/AGENTS.common-rules.md",
        "destination": "AGENTS.md",
        "start_marker": "<!-- AI-PLATFORM:START -->",
        "end_marker": "<!-- AI-PLATFORM:END -->"
      },
      "files": [
        {
          "enabled": false,
          "source": "templates/issue-form.yml",
          "destination": ".github/ISSUE_TEMPLATE/ai-platform.yml"
        },
        {
          "enabled": false,
          "source": "templates/pull-request-template.md",
          "destination": ".github/pull_request_template.md"
        },
        {
          "enabled": false,
          "source": "templates/ci-summary-caller.yml",
          "destination": ".github/workflows/ai-platform-ci-summary.yml"
        },
        {
          "enabled": false,
          "source": "templates/CLAUDE.bridge.md",
          "destination": "CLAUDE.md"
        },
        {
          "enabled": false,
          "source": "prompts/coding-agent-typescript-python.md",
          "destination": ".claude/rules/ai-platform-common.md"
        },
        {
          "enabled": false,
          "source": "prompts/implement-issue.md",
          "destination": ".claude/commands/implement-issue.md"
        },
        {
          "enabled": false,
          "source": "prompts/fix-ci.md",
          "destination": ".claude/commands/fix-ci.md"
        },
        {
          "enabled": false,
          "source": "prompts/review-pr.md",
          "destination": ".claude/commands/review-pr.md"
        },
        {
          "enabled": false,
          "source": "prompts/investigate-issue.md",
          "destination": ".claude/commands/investigate-issue.md"
        }
      ]
    }
  ]
}
